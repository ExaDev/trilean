{
  "name": "trilean",
  "description": "Three-valued predicate and expression evaluation trees, stored as JSON and evaluated against injected resolvers, for domain logic (business rules, eligibility checks, formulas, search filters, and more) that needs to be data instead of code.",
  "version": "3.3.1",
  "bin": {
    "trilean": "./dist-cli/trilean.mjs"
  },
  "bugs": {
    "url": "https://github.com/ExaDev/trilean/issues"
  },
  "dependencies": {
    "trilean-regex": "2.0.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@exadev/eslint-config": "3.1.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "8.20.0",
    "canonicalize": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "default": "./dist/tree.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation.d.ts",
      "default": "./dist/evaluation.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers.d.ts",
      "default": "./dist/resolvers.js"
    },
    "./functions": {
      "types": "./dist/functions.d.ts",
      "default": "./dist/functions.js"
    },
    "./builtin-functions": {
      "types": "./dist/builtin-functions.d.ts",
      "default": "./dist/builtin-functions.js"
    },
    "./computed-value": {
      "types": "./dist/computed-value.d.ts",
      "default": "./dist/computed-value.js"
    },
    "./json-value": {
      "types": "./dist/json-value.d.ts",
      "default": "./dist/json-value.js"
    },
    "./evaluator-factory": {
      "types": "./dist/evaluator-factory.d.ts",
      "default": "./dist/evaluator-factory.js"
    },
    "./evaluator-budget": {
      "types": "./dist/evaluator-budget.d.ts",
      "default": "./dist/evaluator-budget.js"
    },
    "./derived-connectives": {
      "types": "./dist/derived-connectives.d.ts",
      "default": "./dist/derived-connectives.js"
    },
    "./derived-aggregates": {
      "types": "./dist/derived-aggregates.d.ts",
      "default": "./dist/derived-aggregates.js"
    },
    "./derived-values": {
      "types": "./dist/derived-values.d.ts",
      "default": "./dist/derived-values.js"
    },
    "./derived-patterns": {
      "types": "./dist/derived-patterns.d.ts",
      "default": "./dist/derived-patterns.js"
    },
    "./complex": {
      "types": "./dist/complex.d.ts",
      "default": "./dist/complex.js"
    },
    "./input-resolvers": {
      "types": "./dist/input-resolvers.d.ts",
      "default": "./dist/input-resolvers.js"
    },
    "./evaluate-document": {
      "types": "./dist/evaluate-document.d.ts",
      "default": "./dist/evaluate-document.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./schemas/trilean.schema.json": "./schemas/trilean.schema.json"
  },
  "files": [
    "dist",
    "dist-cli",
    "generated",
    "schemas"
  ],
  "homepage": "https://github.com/ExaDev/trilean/tree/main/packages/trilean",
  "imports": {
    "#init": {
      "workerd": "./generated/init.workerd.js",
      "node": "./generated/init.node.js",
      "default": "./generated/init.browser.js"
    }
  },
  "keywords": [
    "evaluator",
    "expression",
    "isomorphic",
    "json",
    "predicate",
    "rules-engine",
    "standard-schema",
    "three-valued-logic",
    "zod"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/trilean.git",
    "directory": "packages/trilean"
  },
  "scripts": {
    "_build": "sh ../../scripts/rust.sh xtask npm trilean && tsdown",
    "_lint": "eslint . --fix --cache --max-warnings 0",
    "_prepush": "true",
    "_test": "vitest run --project unit",
    "_test:coverage": "vitest run --project unit --coverage",
    "_test:e2e": "vitest run --project e2e",
    "_test:integration": "vitest run --project integration",
    "_test:smoke": "vitest run --project smoke",
    "_test:workers": "vitest run --project workers",
    "_typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "_typecheck:attw": "attw --pack --profile esm-only",
    "build": "turbo run _build",
    "lint": "turbo run _lint",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:integration && pnpm run build && pnpm run test:smoke && publint && attw --pack --profile esm-only",
    "prepush": "turbo run _prepush",
    "test": "turbo run _test",
    "test:coverage": "turbo run _test:coverage",
    "test:e2e": "turbo run _test:e2e",
    "test:integration": "turbo run _test:integration",
    "test:smoke": "turbo run _test:smoke",
    "test:workers": "turbo run _test:workers",
    "typecheck": "turbo run _typecheck _typecheck:attw"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
