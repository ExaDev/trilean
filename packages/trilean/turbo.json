{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The package's schemas and types are generated from the Rust workspace into `generated/`, and the schema document into `schemas/`, before tsdown builds the TypeScript that imports them. A change to any crate there reruns the build, and so does the script that runs cargo; the cargo target directory is build output and not an input.
    "_build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/rust/**",
        "!$TURBO_ROOT$/rust/target/**",
        "$TURBO_ROOT$/scripts/rust.sh"
      ],
      "outputs": ["dist/**", "dist-cli/**", "generated/**", "schemas/**"]
    },
    // `$TURBO_ROOT$/conformance/**` is the language-neutral corpus this package's conformance runner reads from outside its own directory, so an edit to it must rerun the unit tests here and nowhere else. It is added to the root definition's inputs ($TURBO_EXTENDS$) in this package alone, because an input listed in the root `turbo.json` would apply to every package's task. Every test task runs against the generated schemas, so it follows this package's own build.
    "_test": {
      "dependsOn": ["$TURBO_EXTENDS$", "_build"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/conformance/**"]
    },
    "_test:coverage": {
      "dependsOn": ["$TURBO_EXTENDS$", "_build"],
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/conformance/**"]
    },
    "_test:integration": {
      "dependsOn": ["$TURBO_EXTENDS$", "_build"]
    },
    "_test:workers": {
      "dependsOn": ["$TURBO_EXTENDS$", "_build"]
    }
  }
}
