{
  "name": "trilean-sql",
  "description": "Compiles a trilean predicate tree into a parameterised SQL WHERE fragment, pushing three-valued logic down onto the database's own NULL propagation instead of evaluating it in process.",
  "version": "2.2.18",
  "bugs": {
    "url": "https://github.com/ExaDev/trilean/issues"
  },
  "dependencies": {
    "trilean": "1.8.0",
    "trilean-regex": "1.0.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@electric-sql/pglite": "^0.5.8",
    "@exadev/eslint-config": "3.0.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^5.0.3",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": {
        "import": "./dist/*.d.ts",
        "require": "./dist/*.d.cts"
      },
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/ExaDev/trilean/tree/main/packages/trilean-sql",
  "keywords": [
    "postgres",
    "predicate",
    "predicate-pushdown",
    "query-builder",
    "rules-engine",
    "sql",
    "sqlite",
    "three-valued-logic",
    "trilean"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/trilean.git",
    "directory": "packages/trilean-sql"
  },
  "scripts": {
    "_build": "tsdown",
    "_lint": "eslint . --fix --cache --max-warnings 0",
    "_prepush": "true",
    "_test": "vitest run --project unit",
    "_test:coverage": "vitest run --project unit --coverage",
    "_test:integration": "vitest run --project integration",
    "_typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "_typecheck:attw": "attw --pack",
    "build": "turbo run _build",
    "lint": "turbo run _lint",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:integration && pnpm run build && publint && attw --pack",
    "prepush": "turbo run _prepush",
    "test": "turbo run _test",
    "test:coverage": "turbo run _test:coverage",
    "test:integration": "turbo run _test:integration",
    "typecheck": "turbo run _typecheck _typecheck:attw"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
