{
  "name": "trilean-regex",
  "description": "A portable regular-expression grammar -- a true regular language, with a Thompson-construction reference matcher -- so a pattern means the same thing in process and wherever trilean-sql can push it down to a database's own engine.",
  "version": "1.0.9",
  "bugs": {
    "url": "https://github.com/ExaDev/trilean/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@exadev/eslint-config": "3.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": {
        "import": "./dist/*.d.ts",
        "require": "./dist/*.d.cts"
      },
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/ExaDev/trilean/tree/main/packages/trilean-regex",
  "keywords": [
    "finite-automaton",
    "isomorphic",
    "nfa",
    "parser",
    "regex",
    "regular-expression",
    "regular-language",
    "trilean"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/trilean.git",
    "directory": "packages/trilean-regex"
  },
  "scripts": {
    "_build": "tsdown",
    "_lint": "eslint . --fix --cache --max-warnings 0",
    "_prepush": "true",
    "_test": "vitest run --project unit",
    "_test:coverage": "vitest run --project unit --coverage",
    "_typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "_typecheck:attw": "attw --pack",
    "build": "turbo run _build",
    "lint": "turbo run _lint",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && publint && attw --pack",
    "prepush": "turbo run _prepush",
    "test": "turbo run _test",
    "test:coverage": "turbo run _test:coverage",
    "typecheck": "turbo run _typecheck _typecheck:attw"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
