{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The package's files are built from the Rust workspace, so its build is rerun by a change to any crate there, and by the entry point that runs cargo. The cargo target directory sits under rust/ and is build output, so it is not an input.
    "_build": {
      "inputs": [
        "package.json",
        "$TURBO_ROOT$/rust/**",
        "!$TURBO_ROOT$/rust/target/**",
        "$TURBO_ROOT$/scripts/rust.sh"
      ],
      "outputs": ["dist/**"]
    }
  }
}
