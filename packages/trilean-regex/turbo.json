{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The package's files are built from the Rust workspace, so its build is rerun by a change to any crate there, and by the entry point that runs cargo. The cargo target directory sits under rust/ and is build output, so it is not an input.
    "_build": {
      "inputs": [
        "package.json",
        "$TURBO_ROOT$/rust/**",
        "!$TURBO_ROOT$/rust/target/**",
        "$TURBO_ROOT$/scripts/rust.sh"
      ],
      "outputs": ["dist/**"]
    },
    // The tests run against the built package, so they follow its build and are rerun by a change to it.
    "_test": {
      "dependsOn": ["^_build", "_build"],
      "inputs": ["test/**", "vitest.config.ts", "package.json"]
    },
    "_test:coverage": {
      "dependsOn": ["^_build", "_build"],
      "inputs": ["test/**", "vitest.config.ts", "package.json"]
    },
    // Builds a consumer with each bundler from the packed package and runs it in a browser and in Node, which is why it is its own task: it follows the build, needs a browser installed and is never cached.
    "_test:e2e": {
      "cache": false,
      "dependsOn": ["^_build", "_build"],
      "inputs": ["test/**", "vitest.config.ts", "package.json"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
