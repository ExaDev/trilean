{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "_typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "tsconfig.node.json"],
      "outputs": []
    },
    "_lint": {
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.ts"],
      "outputs": [".eslintcache"]
    },
    "_test": {
      "inputs": ["src/**", "vitest.config.ts", "vitest.unit.config.ts", "package.json"],
      "outputs": []
    },
    "_test:coverage": {
      "inputs": ["src/**", "vitest.config.ts", "vitest.unit.config.ts", "package.json"],
      "outputs": ["coverage/**"]
    },
    "_test:integration": {
      "inputs": ["src/**", "package.json", "vitest.config.ts", "vitest.integration.config.ts", "test/integration/**"],
      "outputs": []
    },
    "_test:smoke": {
      "inputs": ["src/**", "tsdown.config.ts", "package.json", "vitest.config.ts", "vitest.smoke.config.ts", "test/smoke.test.mjs"],
      "outputs": []
    },
    "_test:workers": {
      "inputs": ["src/**", "package.json", "vitest.config.ts", "vitest.workers.config.ts", "wrangler.jsonc", "test/workers/**"],
      "outputs": []
    },
    "_build": {
      "inputs": ["src/**", "tsdown.config.ts", "package.json"],
      "outputs": ["dist/**", "schemas/**"]
    }
  }
}
